{
  "name": "investidor-brapi",
  "version": "1.0.0",
  "description": "App de análise fundamentalista com Brapi",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "node --watch --watch-path=scripts server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "db:init": "node scripts/init-collections.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1"
  }
}
